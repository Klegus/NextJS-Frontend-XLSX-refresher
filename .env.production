# Production environment variables
# UWAGA: ten plik NIE zawiera sekretów — tylko defaulty.
# Prawdziwe sekrety (CLIENT_SECRET, JWT_SECRET) ustaw przez:
# - zmienne środowiskowe hostingu (Vercel, Railway, Docker)
# - osobny .env.production.local (nieversjonowany)

# Feature flags
# NEXT_PUBLIC_ENABLE_CENSORSHIP=false

# ─── Azure AD / Entra ID (produkcja) ────────────────────
# CLIENT_ID i TENANT_ID są publiczne — można mieć tutaj
# NEXT_PUBLIC_AZURE_AD_CLIENT_ID=
# NEXT_PUBLIC_AZURE_AD_TENANT_ID=

# OAuth callback — produkcyjna domena
NEXT_PUBLIC_REDIRECT_URI=https://planinf.pl/api/auth/callback
REDIRECT_URI=https://planinf.pl/api/auth/callback
PRODUCTION_BASE_URL=https://planinf.pl

# ─── UWAGA: te MUSZĄ być ustawione przez zmienne środowiskowe hostingu ─────
# NIE umieszczaj ich w git! Ustaw przez docker -e, Vercel settings, etc.
# AZURE_AD_CLIENT_SECRET=
# JWT_SECRET=
