# ==============================================================================
# FRONTEND ENVIRONMENT VARIABLES
# ==============================================================================

# API Configuration
# -----------------
# Base URL for backend API (Flask)
# For local development with backend on port 5000:
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# For production (if frontend and backend are on same domain):
# NEXT_PUBLIC_API_BASE_URL=

# For production with separate backend:
# NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com

# ==============================================================================
# REDIS CACHE (Upstash) - OPTIONAL but recommended for performance
# ==============================================================================

# Get these from https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# ==============================================================================
# FEATURE FLAGS
# ==============================================================================

# Enable/disable lecturer name censorship
# Set to "true" to hide lecturer names, "false" to show them
NEXT_PUBLIC_ENABLE_CENSORSHIP=false

# ==============================================================================
# DEVELOPMENT SETTINGS
# ==============================================================================

# Node environment (development/production)
NODE_ENV=development

# Next.js telemetry (optional - set to 1 to disable)
NEXT_TELEMETRY_DISABLED=1

# ==============================================================================
# OPTIONAL FEATURES
# ==============================================================================

# Google Analytics (optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Sentry error tracking (optional)
# NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# ==============================================================================
# BUILD TIME VARIABLES (optional)
# ==============================================================================

# Revalidation time for static pages (in seconds)
# How often to refetch data in production
NEXT_PUBLIC_REVALIDATE_TIME=60

# ==============================================================================
# NOTES FOR DEPLOYMENT
# ==============================================================================

# For Vercel deployment:
# - Add these variables in Vercel dashboard under Settings > Environment Variables
# - NEXT_PUBLIC_* variables are exposed to the browser
# - Other variables are server-side only

# For Docker deployment:
# - Pass these as build args or runtime environment
# - Update docker-compose.yml or Dockerfile as needed

# For local development:
# 1. Copy this file to .env.local
# 2. Fill in your values
# 3. Never commit .env.local to git